{
  "name": "@ptcg/mc-bot",
  "version": "0.2.1",
  "description": "Flat Monte Carlo AI for ptcg game, built on top of simple-bot.",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    "require": {
      "types": "./dist/cjs/index.d.ts",
      "default": "./dist/cjs/index.js"
    },
    "import": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "lint": "eslint -c .eslintrc.js --ext .ts src",
    "compile": "tsc && tsc -p tsconfig.esm.json",
    "build": "npm run lint && npm run test && npm run compile",
    "test": "nyc -e \".ts\" -x \"src/**/*.spec.ts\" jasmine-ts \"src/**/*.spec.ts\"",
    "coverage": "npm test && nyc report -r html",
    "eval": "node scripts/evaluate.js"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ptcg/common": "*",
    "@ptcg/simple-bot": "*"
  },
  "devDependencies": {
    "@ptcg/sets": "*",
    "@types/jasmine": "~4.3.0",
    "@types/node": "^18.19.87",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "^8.31.1",
    "jasmine": "^3.9.0",
    "jasmine-ts": "~0.4.0",
    "ts-node": "^10.9.2",
    "typescript": "~4.9.5"
  }
}
